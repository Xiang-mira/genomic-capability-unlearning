{
  "description": "Phase 2 selective-unlearning sweeps. The default path prioritizes a training-free joint probe null-space projection plus probe-guided localized fine-tuning on layers 5-9 for the combined host_tropism + coronaviridae objective. GD sweeps now use probe-guided representation loss rather than CE gradient-difference loss and explicitly initialize from the projection checkpoint. The canonical retain.csv is GUE-augmented, and the preferred RMU follow-up now lives in the dedicated rmu_localized_nonhuman.json grid so projection checkpoints and RMU checkpoints can be screened against the same pilot HVUE/GUE benchmark path.",
  "train_defaults": {
    "forget_csv": "data/phase2/splits/forget.csv",
    "retain_csv": "data/phase2/splits/retain.csv",
    "internal_target_config": "phase2/internal_eval_targets.json"
  },
