    },
    {
      "group": "target_specific",
      "name": "projopt_host5_9_coro5_12_coro125",
      "method": "probe_nullspace",
      "args": {"target_layers": "host_tropism=5-9,coronaviridae=5-12", "projection_strength": 1.0, "target_strengths": "host_tropism=1.0,coronaviridae=1.25"}
    },
    {
